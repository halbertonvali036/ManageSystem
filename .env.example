# Public frontend environment variables.
# Copy this file to `.env` and set real values. Do not commit secrets.

# Base URL of the REST API provided by the backend team.
# Leave empty while the backend is unavailable; the frontend then shows
# backend-unavailable states instead of failing.
VITE_API_BASE_URL=
# Optional; leave unset until the deployment architecture is defined.
VITE_PLATFORM_BASE_DOMAIN=
