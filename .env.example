# Public frontend environment variables.
# Every VITE_ value is embedded in the browser bundle. Never put secrets here.
# Copy this file to `.env` and set real values. Do not commit secrets.

# Backend origin, WITHOUT a trailing /api (site paths already include /api).
# Leave empty while the backend is unavailable; the frontend then shows
# backend-unavailable states instead of failing.
VITE_API_BASE_URL=
# Bare platform domain, e.g. sites.example.com; no scheme or path.
VITE_PLATFORM_BASE_DOMAIN=
# Leave empty for the dashboard. Set host ONLY on the separate public-site
# deployment that receives custom domains and platform wildcard traffic.
# Uses /api/public/sites/{slug} or /api/public/sites/by-domain?host=...
VITE_PUBLIC_SITE_MODE=
# Demo sign-in is removed from the frontend; authentication is backend-only.
# This flag remains for documentation/compatibility and must stay 'false'.
# No secrets — this is embedded in the browser bundle.
VITE_ENABLE_DEMO_AUTH=false
